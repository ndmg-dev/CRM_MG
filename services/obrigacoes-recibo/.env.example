# Worker de baixa por recibo — Obrigações Acessórias
# Copie para .env e preencha.  NUNCA commite o .env.

# --- Supabase do MÓDULO de Obrigações (não é o banco do CRM) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# service_role BYPASSA RLS. Só este worker usa. Nunca no frontend, nunca no
# build do Vite, nunca em variável VITE_*.
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# Conexão direta ao Postgres do projeto (Database Settings > Connection string).
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# --- Opcionais ---
STORAGE_BUCKET=obrigacoes-documentos
MAX_ARQUIVO_BYTES=26214400
DEBOUNCE_SEGUNDOS=2.0
WORKERS=2
RECARGA_PASTAS_SEGUNDOS=300
LOG_LEVEL=INFO
