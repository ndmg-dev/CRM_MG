{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@calc/*": ["./src/systems/calculadora-rescisao/*"],
      "@suporte/*": ["./src/systems/central-suporte/*"],
      "@ferias/*": ["./src/systems/agendamento-ferias/*"],
      "@ponto/*": ["./src/systems/processar-ponto/*"],
      "@obrigacoes/*": ["./src/systems/obrigacoes/*"],
      "@adiantamento/*": ["./src/systems/calculo-adiantamento/*"],
      "@aeronord/*": ["./src/systems/aeronord/*"],
      "@comissao/*": ["./src/systems/calculo-comissao/*"],
      "@pontoadmin/*": ["./src/systems/ponto-admin/*"],
      "@guiadp/*": ["./src/systems/guia-dp/*"],
      "@fiscal/*": ["./src/systems/conciliacao-fiscal/*"],
      "@abertura/*": ["./src/systems/abertura-empresa/*"],
      "@copilot/*": ["./src/systems/copilot-contabil/*"],
      "@bimg/*": ["./src/systems/bimg/*"],
      "@contai/*": ["./src/systems/contai/*"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"]
}
