# =============================================================================
# CRM Mendonça Galvão — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file with real credentials.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=crm_mendonca_galvao
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- pgAdmin (dev only) ---
PGADMIN_EMAIL=admin@mendoncagalvao.com.br
PGADMIN_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050

# --- Backend (Spring Boot) ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- JWT ---
JWT_SECRET=CHANGE_ME_USE_A_STRONG_256_BIT_KEY
JWT_EXPIRATION_MS=86400000

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_ALLOWED_DOMAIN=mendoncagalvao.com.br

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
