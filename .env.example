# =============================================================================
# CRM Mendonça Galvão — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:  cp .env.example .env
# NEVER commit the .env file with real credentials (.env is gitignored).
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=crm_mendonca_galvao
POSTGRES_USER=crm_admin
POSTGRES_PASSWORD=CHANGE_ME
# Host/port used by the backend to reach the database.
# When running via docker-compose the backend service overrides these to
# POSTGRES_HOST=postgres / POSTGRES_PORT=5432 automatically.
# When running the backend on your host (e.g. pytest), point them at the
# database published by docker-compose: localhost:${HOST_POSTGRES_PORT}.
POSTGRES_HOST=localhost
POSTGRES_PORT=5439

# --- pgAdmin (dev only) ---
PGADMIN_EMAIL=admin@mendoncagalvao.com.br
PGADMIN_PASSWORD=CHANGE_ME

# --- Published host ports (docker-compose) ---
HOST_POSTGRES_PORT=5439
HOST_PGADMIN_PORT=5059
HOST_BACKEND_PORT=8089
HOST_FRONTEND_PORT=3009

# --- JWT / Auth ---
# Generate a strong key, e.g.:  openssl rand -base64 48
JWT_SECRET=CHANGE_ME_USE_A_STRONG_256_BIT_KEY
JWT_EXPIRATION_SECONDS=86400

# --- Ingestão n8n -> CRM (módulo Extratos de Sócios) ---
# Segredo compartilhado do HMAC-SHA256 da ingestão (header X-Signature).
# Obrigatório (o backend não sobe sem ele). Mesmo valor configurado no n8n.
# Gere com:  openssl rand -base64 48
N8N_INGEST_SECRET=CHANGE_ME_USE_A_STRONG_SHARED_SECRET

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# --- OpenAI (AI features) ---
OPENAI_API_KEY=sk-your-openai-api-key

# --- Evolution API (WhatsApp integration) ---
# EVOLUTION_API_KEY é obrigatório (o backend não sobe sem ele) — sem mais o
# default hardcoded no config.py.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CHANGE_ME
EVOLUTION_INSTANCE=default

# --- Service URLs (used for CORS and the frontend build) ---
# Local development defaults:
SERVICE_URL_FRONTEND=http://localhost:3009
SERVICE_URL_BACKEND=http://localhost:8089
